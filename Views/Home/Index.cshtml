@model IEnumerable<App_practical.Models.Variant>

<div class="text-center">
    <h1 class="display-4">Калькулятор Docker</h1>
    
    <form method="post" class="mt-4">
        <input type="text" name="value1" class="form-control mb-2" placeholder="Число 1" required />
        <input type="text" name="value2" class="form-control mb-2" placeholder="Число 2" required />
        <select name="operation" class="form-control mb-2">
            <option>Сложить (+)</option>
            <option>Вычесть (-)</option>
            <option>Умножить (*)</option>
            <option>Разделить (/)</option>
            <option>Возвести в степень (^)</option>
        </select>
        <button type="submit" class="btn btn-primary">Вычислить</button>
    </form>

    @* Bloque de resultado o error usando ViewBag *@
    @if (ViewBag.Result != null || ViewBag.ErrorMessage != null) 
    {
        <div class="mt-4 alert @(ViewBag.ErrorMessage == null ? "alert-success" : "alert-danger")">
            @(ViewBag.ErrorMessage == null ? $"Результат: {ViewBag.Result}" : ViewBag.ErrorMessage)
        </div>
    }

    @if (Model != null && Model.Any())
    {
        <h3 class="mt-5">История вычислений</h3>
        <table class="table table-striped table-bordered mt-3">
            <thead class="table-dark">
                <tr>
                    <th>Число 1</th>
                    <th>Число 2</th>
                    <th>Операция</th>
                    <th>Результат</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>@item.Value1</td>
                        <td>@item.Value2</td>
                        <td>@item.Operation</td>
                        <td>@item.Result</td>
                    </tr>
                }
            </tbody>
        </table>
    }
</div>
